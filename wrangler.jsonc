{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryans-portfolio",
  "account_id": "7ceef36ac9912fb68e8b31dc4634db5b",
  "compatibility_date": "2026-08-05",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "routes": [
    {
      "pattern": "ryan.hurd.cc",
      "zone_name": "hurd.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "out"
  }
}
